{
  "name": "tx_sender_module",
  "display_name": "EVM Transaction Sender",
  "version": "0.1.0",
  "type": "core",
  "interface": "cdylib",
  "concurrency": "multi",
  "category": "wallet",
  "description": "The one EVM transaction sender on the device: one nonce ledger, call bundles approved as one decision in the keystore, ordered broadcast, and a write-ahead local history. Holds no key material and chooses no chain.",
  "author": "Logos Core Team",
  "main": "tx_sender_module_plugin",
  "dependencies": [
    { "name": "eth_rpc_module", "version": "~0.1.0" },
    { "name": "fee_module", "version": "~0.1.0" },
    { "name": "keystore_module", "version": "~0.1.0" }
  ],
  "include": [],
  "capabilities": [],
  "codegen": {
    "rust": {
      "crate": "rust-lib",
      "trait": "TxSenderModule",
      "source": "src/glue.rs"
    }
  },
  "nix": {
    "external_libraries": [],
    "packages": { "build": [], "runtime": [] },
    "cmake": { "find_packages": [], "extra_include_dirs": [] }
  }
}
